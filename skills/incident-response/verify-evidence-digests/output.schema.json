{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "items": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"},
          "source_ids": {
            "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"}
          },
          "expected_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
          "computed_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"},
          "byte_length": {"type": "integer", "minimum": 0, "maximum": 65536},
          "matches": {"type": "boolean"}
        },
        "required": ["id", "source_ids", "expected_sha256", "computed_sha256", "byte_length", "matches"]
      }
    },
    "matched_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "all_match": {"type": "boolean"},
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    }
  },
  "required": ["items", "matched_count", "all_match", "limitations"]
}
