{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "uri": {"type": "string", "minLength": 1, "maxLength": 1024, "format": "uri", "pattern": "^(?:https://|urn:)"}
        },
        "required": ["id", "title", "uri"]
      }
    },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"},
          "source_ids": {
            "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"}
          },
          "content_base64": {"type": "string", "maxLength": 87384, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$(?![\\s\\S])"},
          "expected_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"}
        },
        "required": ["id", "source_ids", "content_base64", "expected_sha256"]
      }
    }
  },
  "required": ["sources", "items"]
}
