{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "format": "uri",
            "pattern": "^(?:https://|urn:)"
          }
        },
        "required": [
          "id",
          "title",
          "uri"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"
          },
          "timestamp": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"
          }
        },
        "required": [
          "id",
          "timestamp",
          "description",
          "source_id"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "sources",
    "events"
  ]
}
