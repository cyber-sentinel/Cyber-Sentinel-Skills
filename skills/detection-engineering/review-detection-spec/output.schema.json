{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"
    },
    "backend": {
      "enum": [
        "splunk-spl",
        "microsoft-kql",
        "elastic-kql",
        "elastic-eql",
        "elastic-esql",
        "sigma"
      ]
    },
    "expression_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9.-]*$(?![\\s\\S])"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "minItems": 0,
      "maxItems": 4
    },
    "metadata_complete": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "minItems": 1,
      "maxItems": 10
    }
  },
  "required": [
    "rule_id",
    "backend",
    "expression_sha256",
    "findings",
    "metadata_complete",
    "limitations"
  ]
}
